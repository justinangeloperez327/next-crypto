# Sign up for a free CoinGecko Demo key:
# https://www.coingecko.com/en/api/pricing
# CoinGecko Demo endpoint: https://api.coingecko.com/api/v3
# Add this to .env.local (never commit .env.local or a real key).
COINGECKO_DEMO_API_KEY=

# DO NOT prefix this with NEXT_PUBLIC_; the key must remain server-side.
# Without a key, GET /api/markets safely returns 503 not_configured.
